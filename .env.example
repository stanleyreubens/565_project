# Database (required)
DATABASE_URL="postgresql://user:password@host:5432/database"

# JWT Secret (required - generate a strong random string)
JWT_SECRET="your-super-secret-jwt-key-change-this"

# RapidAPI (for Hotels API)
RAPIDAPI_KEY="your-rapidapi-key"

# SerpApi (for Google Hotels via SerpApi)
SERPAPI_KEY="your-serpapi-key"

# Competitor price data source: "booking" | "hotellens" | "serpapi"
# booking: full room-type import + Booking.com rates only (uses RAPIDAPI_KEY)
# hotellens: multi-OTA via Google Hotels scrape (uses RAPIDAPI_KEY) - cheap but accuracy issues
# serpapi: multi-OTA via SerpApi's google_hotels engine (uses SERPAPI_KEY) - more reliable
COMPETITOR_PRICE_PROVIDER="booking"

# Ticketmaster (for Events API)
TICKETMASTER_API_KEY="your-ticketmaster-api-key"
