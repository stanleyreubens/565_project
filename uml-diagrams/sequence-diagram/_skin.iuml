skinparam dpi 200
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam defaultFontSize 13
skinparam maxMessageSize 210
skinparam BoxPadding 14
skinparam sequence {
  ArrowColor #14201F
  ArrowFontSize 12
  ArrowFontColor #131A18
  LifeLineBorderColor #8A9691
  LifeLineBackgroundColor #F4F8F6
  ParticipantBorderColor #1C6B58
  ParticipantBackgroundColor #EDF5F2
  ParticipantFontSize 13
  ParticipantFontStyle bold
  ActorBorderColor #14201F
  ActorBackgroundColor #FFFFFF
  ActorFontStyle bold
  BoxBorderColor #14201F
  BoxFontSize 14
  BoxFontStyle bold
  GroupBorderColor #1C6B58
  GroupBackgroundColor #FFFFFF
  GroupHeaderFontColor #1C6B58
  GroupHeaderFontSize 12
}
