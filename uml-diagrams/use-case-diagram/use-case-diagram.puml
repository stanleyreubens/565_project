@startuml use-case-diagram
' Hotel Revenue Manager - Use Case Diagram

skinparam dpi 200
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam defaultFontSize 14
skinparam ArrowColor #14201F
skinparam ArrowFontSize 12
skinparam ArrowFontColor #4A5A55
skinparam usecase {
  BackgroundColor #EDF5F2
  BorderColor #1C6B58
  BorderThickness 1.4
  FontSize 14
  FontColor #131A18
}
skinparam actor {
  BackgroundColor #FFFFFF
  BorderColor #14201F
  FontSize 14
  FontStyle bold
}
skinparam rectangle {
  BackgroundColor #FBFCFB
  BorderColor #14201F
  BorderThickness 2
  FontSize 17
  FontStyle bold
  FontColor #14201F
}

top to bottom direction
skinparam nodesep 40
skinparam ranksep 65

actor "Revenue\nManager" as RM
actor "Organisation\nAdministrator" as OA
actor "Platform\nAdministrator" as PA
actor "Rate Provider" as RP
actor "Events Service" as ES

OA -up-|> RM

rectangle "Hotel Revenue Manager" {

  usecase "UC1\nGenerate Rate\nRecommendation" as UC1
  usecase "UC2\nRetrieve\nCompetitor Rates" as UC2
  usecase "UC3\nRetrieve\nLocal Events" as UC3
  usecase "UC4\nApply\nPricing Floor" as UC4
  usecase "UC5\nManage\nCompetitor Set" as UC5
  usecase "UC6\nMaintain Contracted\nGroup Rates" as UC6
  usecase "UC7\nReview\nMarket Report" as UC7
  usecase "UC8\nManage Property\nand Room Types" as UC8
  usecase "UC9\nRecord\nActual Rate" as UC9
  usecase "UC10\nImport Property\nfrom Provider" as UC10
  usecase "UC11\nOverride Event\nImpact Score" as UC11
  usecase "UC12\nSearch Provider\nCatalogue" as UC12
  usecase "UC13\nAuthenticate" as UC13
  usecase "UC14\nConfigure\nData Provider" as UC14

  UC1 ..> UC2 : <<include>>
  UC1 ..> UC3 : <<include>>
  UC1 ..> UC4 : <<include>>
  UC1 ..> UC13 : <<include>>
  UC5 ..> UC12 : <<include>>
  UC7 ..> UC2 : <<include>>
  UC8 ..> UC13 : <<include>>
  UC10 ..> UC12 : <<include>>

  UC9 ..> UC1 : <<extend>>
  UC10 ..> UC8 : <<extend>>
  UC11 ..> UC3 : <<extend>>
}

RM --> UC1
RM --> UC5
RM --> UC6
RM --> UC7
RM --> UC8
PA --> UC14

UC2 --> RP
UC12 --> RP
UC3 --> ES

@enduml
